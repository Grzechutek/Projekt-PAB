@page "/friend/{Id:int}/library"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 mb-16">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Class="mb-4" Href="/friends">
        Wróć do listy znajomych
    </MudButton>

    <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-6" Style="font-weight: bold;">Biblioteka Znajomego</MudText>

    @if (_isLoading)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (_games == null || !_games.Any())
    {
        <MudContainer MaxWidth="MaxWidth.Small" Class="text-center mt-16">
            <MudIcon Icon="@Icons.Material.Filled.VideogameAssetOff" Color="Color.Surface" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h5" Style="color: #94a3b8; font-weight: bold;">Pusto tutaj</MudText>
            <MudText Typo="Typo.body1" Style="color: #64748b;" Class="mb-6 mt-2">
                Wygląda na to, że ten gracz nie posiada jeszcze żadnych gier na swoim koncie.
            </MudText>
        </MudContainer>
    }
    else
    {
        <MudGrid>
            @foreach (var game in _games)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="4" Style="background-color: #1e1e2d; color: white; border-radius: 12px; height: 100%; display: flex; flex-direction: column;">
                        <MudCardMedia Image="@(string.IsNullOrEmpty(game.CoverImageUrl) ? "https://placehold.co/600x400/2a2a35/a855f7?text=Brak+Okładki" : game.CoverImageUrl)" Height="200" />
                        
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="font-weight: bold;">@game.Title</MudText>
                            <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                                W kolekcji znajomego
                            </MudText>
                        </MudCardContent>
                        
                        <MudCardActions Class="mt-auto pb-4 px-4 d-flex justify-end">
                            <MudTooltip Text="Szczegóły i Recenzje">
                                <MudIconButton Icon="@Icons.Material.Filled.StarRate" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@(() => GoToDetails(game.Id))" />
                            </MudTooltip>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private List<FriendGameDto>? _games;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/users/{Id}/library");
            if (response.IsSuccessStatusCode)
            {
                _games = await response.Content.ReadFromJsonAsync<List<FriendGameDto>>();
            }
            else
            {
                Snackbar.Add("Nie masz uprawnień, aby zobaczyć tę bibliotekę.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Błąd wczytywania gier.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoToDetails(int gameId)
    {
        NavManager.NavigateTo($"/game/{gameId}");
    }

    public class FriendGameDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? CoverImageUrl { get; set; }
    }
}