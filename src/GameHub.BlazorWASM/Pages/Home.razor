@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-6" Style="font-weight: bold;">Sklep GameHub</MudText>

    @if (_games == null)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (!_games.Any())
    {
        <MudText Typo="Typo.h5" Style="color: #94a3b8;">Brak gier w aktualnej ofercie.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var game in _games.Where(g =>
    string.IsNullOrEmpty(SearchQuery) ||
    g.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
    g.Description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="4" Style="background-color: #1e1e2d; color: white; border-radius: 12px; height: 100%; display: flex; flex-direction: column;">
                        <MudCardMedia Image="@(string.IsNullOrEmpty(game.CoverImageUrl) ? "https://placehold.co/600x400/2a2a35/a855f7?text=Brak+Okładki" : game.CoverImageUrl)" Height="200" />
                        
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="font-weight: bold;">@game.Title</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-4">
                                @(game.Description.Length > 80 ? game.Description.Substring(0, 80) + "..." : game.Description)
                            </MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.h5" Style="color: #eab308; font-weight: bold;">
                                @game.Price.ToString("0.00") PLN
                            </MudText>
                        </MudCardContent>
                        
                        @* Zaktualizowana sekcja z dwoma przyciskami *@
                        <MudCardActions Class="mt-auto pb-4 px-4 d-flex align-center gap-2">
                            
                            <div style="flex: 1;">
                                <AuthorizeView>
                                    <Authorized>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="@(() => BuyGame(game.Id))" Disabled="@_isProcessing">
                                            Kup teraz
                                        </MudButton>
                                    </Authorized>
                                    <NotAuthorized>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="/login">
                                            Zaloguj się
                                        </MudButton>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                            
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@($"/game/{game.Id}")">
                                Szczegóły
                            </MudButton>
                            
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    [CascadingParameter(Name = "SearchQuery")]
    public string SearchQuery { get; set; } = string.Empty;
    private List<GameDto>? _games;
    private bool _isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _games = await Http.GetFromJsonAsync<List<GameDto>>("api/games");
        }
        catch (Exception)
        {
            Snackbar.Add("Nie udało się połączyć z serwerem sklepu.", Severity.Error);
        }
    }

    private async Task BuyGame(int gameId)
    {
        _isProcessing = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{gameId}/buy", null);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Gra została dodana do Twojej biblioteki!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Nie udało się sfinalizować zakupu. Sprawdź saldo portfela.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił błąd transakcji.", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    public class GameDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string? CoverImageUrl { get; set; }
    }
}