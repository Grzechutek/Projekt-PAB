@page "/"
@using GameHub.BlazorWASM.Models
@using GameHub.BlazorWASM.Services
@inject GameService GameService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h3" GutterBottom="true" Color="Color.Primary">Sklep</MudText>

@if (games == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!games.Any())
{
    <MudText Typo="Typo.h6">Brak gier w sklepie.</MudText>
}
else
{
    <MudGrid>
        @foreach (var game in games)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="4" Style="height: 100%; display: flex; flex-direction: column; background-color: #1e1e2d; color: white;">
                    <MudCardMedia Image="@(string.IsNullOrEmpty(game.CoverImageUrl) ? "https://placehold.co/600x400/2a2a3c/a855f7?text=Brak+Ok%C5%82adki" : game.CoverImageUrl)" Height="200" />
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@game.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="mb-2">@game.Genre</MudText>
                        <MudText Typo="Typo.body2" Style="flex-grow: 1; color: #a0a0b0;">
                            @(game.Description?.Length > 80 ? game.Description.Substring(0, 80) + "..." : game.Description)
                        </MudText>
                    </MudCardContent>
                    <MudCardActions Class="mt-auto d-flex justify-space-between align-center">
                        <MudText Typo="Typo.h6" Color="Color.Success"><strong>@game.Price PLN</strong></MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => HandleBuyClick(game))">Kup</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<GameDto>? games;

    protected override async Task OnInitializedAsync()
    {
        // Pobieramy dane z Twojego API
        games = await GameService.GetGamesAsync();
    }

    private async Task HandleBuyClick(GameDto game)
    {
        // TUTAJ JEST POPRAWKA: ShowMessageBoxAsync zamiast ShowMessageBox
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Potwierdzenie zakupu",
            $"Czy na pewno chcesz kupić grę '{game.Title}' za {game.Price} PLN?",
            yesText: "Kupuję", cancelText: "Anuluj");

        // 2. Jeśli użytkownik kliknął "Kupuję"
        if (result == true)
        {
            var success = await GameService.BuyGameAsync(game.Id);

            if (success)
            {
                Snackbar.Add($"Sukces! Gra {game.Title} została dodana do biblioteki.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Zakup nie powiódł się. Sprawdź saldo portfela lub czy masz już tę grę.", Severity.Error);
            }
        }
    }
}