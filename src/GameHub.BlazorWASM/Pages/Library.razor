@page "/library"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-6" Style="font-weight: bold;">Moja Biblioteka</MudText>

    @if (_isLoading)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (_myGames == null || !_myGames.Any())
    {
        @* PIĘKNY STAN PUSTY (Gdy gracz nie ma jeszcze gier) *@
        <MudContainer MaxWidth="MaxWidth.Small" Class="text-center mt-16">
            <MudIcon Icon="@Icons.Material.Filled.VideogameAssetOff" Color="Color.Surface" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h5" Style="color: #94a3b8; font-weight: bold;">Twoja biblioteka jest pusta</MudText>
            <MudText Typo="Typo.body1" Style="color: #64748b;" Class="mb-6 mt-2">
                Wygląda na to, że nie posiadasz jeszcze żadnych gier. Czas wyruszyć na zakupy i znaleźć coś dla siebie!
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/">
                Wróć do Sklepu
            </MudButton>
        </MudContainer>
    }
    else
    {
        @* SIATKA POSIADANYCH GIER *@
        <MudGrid>
            @foreach (var game in _myGames.Where(g =>
    string.IsNullOrEmpty(SearchQuery) ||
    g.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="4" Style="background-color: #1e1e2d; color: white; border-radius: 12px; height: 100%; display: flex; flex-direction: column;">
                        <MudCardMedia Image="@(string.IsNullOrEmpty(game.CoverImageUrl) ? "https://placehold.co/600x400/2a2a35/a855f7?text=Brak+Okładki" : game.CoverImageUrl)" Height="200" />
                        
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="font-weight: bold;">@game.Title</MudText>
                            @if(game.PurchasedAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                                    Zakupiono: @game.PurchasedAt.Value.ToString("dd.MM.yyyy")
                                </MudText>
                            }
                        </MudCardContent>
                        
                        <MudCardActions Class="mt-auto pb-4 px-4 d-flex justify-space-between">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@PlayGame" Class="flex-grow-1 mr-2">
                                Zagraj
                            </MudButton>
                            
                            @* Przycisk do wystawiania opinii *@
                            <MudTooltip Text="Szczegóły i Recenzje">
                                <MudIconButton Icon="@Icons.Material.Filled.StarRate" Color="Color.Secondary" Variant="Variant.Filled" OnClick="@(() => GoToDetails(game.Id))" />
                            </MudTooltip>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    [CascadingParameter(Name = "SearchQuery")]
    public string SearchQuery { get; set; } = string.Empty;
    private List<LibraryGameDto>? _myGames;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Oczekujemy, że ten endpoint zwraca gry należące do zalogowanego użytkownika
            _myGames = await Http.GetFromJsonAsync<List<LibraryGameDto>>("api/games/library");
        }
        catch (Exception)
        {
            Snackbar.Add("Nie udało się pobrać gier z serwera.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PlayGame()
    {
        // Mock uruchamiania gry :)
        Snackbar.Add("Uruchamianie silnika gry... (Symulacja!)", Severity.Info);
    }

    private void GoToDetails(int gameId)
    {
        // Przenosi do widoku pojedynczej gry
        NavManager.NavigateTo($"/game/{gameId}");
    }

    // Klasa reprezentująca dane odbierane z backendu
    public class LibraryGameDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public DateTime? PurchasedAt { get; set; }
        public string? CoverImageUrl { get; set; }
    }
}